# 使用已发布的镜像（推荐生产环境，版本见 GitHub Releases）；留空则从源码构建
# CRM_IMAGE=ghcr.io/porryer/crmcms:1.7.1
CRM_ADMIN_EMAIL=admin@local.crm
CRM_ADMIN_PASSWORD=ChangeMe_To_A_Unique_Strong_Password_2026!
# 生产部署通过HTTPS反代并设置 COOKIE_SECURE=1
COOKIE_SECURE=0
PUBLIC_ORIGIN=http://localhost:3100
# 统计口径（本月/按日趋势）使用的业务时区
TZ=Asia/Shanghai
# PUBLIC_ORIGIN 可配置多个，用逗号分隔
# HTTPS 部署（compose.https.yaml）使用的域名
CRM_DOMAIN=crm.example.com
# 自动备份间隔（小时，0 关闭）与保留份数
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# 登录会话有效期（小时，1-720）
SESSION_HOURS=8
